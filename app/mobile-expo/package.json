{
  "name": "mobile-expo",
  "version": "0.0.1",
  "private": true,
  "main": "./index.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "build:android:release": "rm -rf android/app/.cxx android/app/build android/build && NODE_ENV=production ./android/gradlew -p android :app:assembleRelease --no-build-cache",
    "run:android:release": "rm -rf android/app/.cxx android/app/build android/build && expo run:android --variant release --no-build-cache",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ebtest/mobile-app": "workspace:*",
    "@ebtest/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.0",
    "expo-navigation-bar": "~57.0.2",
    "expo-localization": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "babel-preset-expo": "~57.0.8",
    "typescript": "^5.9.3"
  }
}
