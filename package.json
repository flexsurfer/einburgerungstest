{
  "name": "einburgerungstest",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "pnpm --filter ./packages/shared exec vitest run && pnpm --filter ./packages/mobile-app exec vitest run && pnpm --filter ./app/web exec vitest run",
    "test:web": "pnpm --filter ./app/web exec vitest run",
    "test:mobile": "pnpm --filter ./packages/mobile-app exec vitest run",
    "test:mobile-app": "pnpm --filter ./packages/mobile-app exec vitest run",
    "test:shared": "pnpm --filter ./packages/shared exec vitest run",
    "typecheck:mobile": "pnpm --filter ./app/mobile exec tsc --noEmit -p tsconfig.json",
    "typecheck:mobile-app": "pnpm --filter ./packages/mobile-app exec tsc --noEmit -p tsconfig.json",
    "typecheck:mobile-expo": "pnpm --filter ./app/mobile-expo run typecheck",
    "preview:web": "pnpm --filter ./app/web exec vite preview",
    "dev:web": "pnpm --filter ./app/web exec vite",
    "dev:mobile": "pnpm --filter ./app/mobile exec react-native start",
    "dev:run-android": "pnpm --filter ./app/mobile exec react-native run-android",
    "dev:run-ios": "pnpm --filter ./app/mobile exec react-native run-ios",
    "dev:expo": "pnpm --filter ./app/mobile-expo exec expo start",
    "dev:expo-android": "pnpm --filter ./app/mobile-expo exec expo run:android",
    "dev:expo-ios": "pnpm --filter ./app/mobile-expo exec expo run:ios",
    "build:expo-android": "pnpm --filter mobile-expo run build:android:release",
    "run:expo-android-release": "pnpm --filter mobile-expo run run:android:release",
    "build:web": "pnpm --filter ./app/web exec vite build",
    "build": "pnpm build:web",
    "deploy:web": "gh-pages -d ./app/web/dist"
  },
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "devDependencies": {
    "eslint": "~9.39.5",
    "gh-pages": "^6.3.0",
    "jiti": "2.7.0",
    "jsdom": "~30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "react": "19.2.8"
  }
}
