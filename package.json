{
  "name": "einburgerungstest",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "pnpm test:shared && pnpm test:mobile-app && pnpm test:web-app",
    "test:all": "pnpm test && pnpm test:web && pnpm test:content",
    "test:content": "pnpm --dir mobile-expo run test:content",
    "test:web": "pnpm --dir website run test",
    "test:web-app": "pnpm --filter ./packages/web-app run test",
    "test:mobile": "pnpm test:mobile-app",
    "test:mobile-app": "pnpm --filter ./packages/mobile-app run test",
    "test:shared": "pnpm --filter ./packages/shared exec vitest run",
    "typecheck:mobile-app": "pnpm --dir mobile-expo run typecheck:mobile-app",
    "typecheck:mobile-expo": "pnpm --dir mobile-expo run typecheck",
    "install:web": "pnpm --dir website install",
    "preview:web": "pnpm --dir website run preview",
    "dev:web": "pnpm --dir website run dev",
    "install:expo": "pnpm --dir mobile-expo install",
    "dev:expo": "pnpm --dir mobile-expo run start",
    "dev:expo-android": "pnpm --dir mobile-expo run android",
    "dev:expo-ios": "pnpm --dir mobile-expo run ios",
    "build:expo-android": "pnpm --dir mobile-expo run build:android:release",
    "build:expo-android-apk": "pnpm --dir mobile-expo run build:android:apk",
    "run:expo-android-release": "pnpm --dir mobile-expo run run:android:release",
    "build:web": "pnpm --dir website run build",
    "build": "pnpm build:web",
    "predeploy": "pnpm --dir website run prepare:deploy",
    "deploy:web": "pnpm --dir website run deploy"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "jiti": "2.7.0",
    "jsdom": "~30.0.1",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
